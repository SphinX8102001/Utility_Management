PORT=5000
MONGO_URI=mongodb://localhost:27017/utility_management_system

# ahnaf start
# Email Verifier Mode — controls which verification engine is used:
#   external  → Debounce free API (disposable check) + DNS MX lookup [DEFAULT, recommended]
#   gmass     → GMass paid API (requires GMASS_API_KEY below)
#   dns       → Local DNS MX record lookup only (no external call)
VERIFIER_MODE=external

# GMass Configuration (kept for future use — only active when VERIFIER_MODE=gmass)
# GMASS_MOCK=true  → uses free local DNS MX record lookup (no API key needed)
# GMASS_MOCK=false → uses the real GMass API at verify.gmass.co (requires paid key)
GMASS_API_KEY=mock
GMASS_MOCK=true
# ahnaf end