PORT=5000
MONGO_URI=mongodb://localhost:27017/utility_management_system

# ahnaf start
# GMass Email Verification Configuration
# GMASS_MOCK=true  → uses free local DNS MX record lookup (no API key needed)
# GMASS_MOCK=false → uses the real GMass API at verify.gmass.co (requires paid key)
GMASS_API_KEY=mock
GMASS_MOCK=true
# ahnaf end
GEMINI_API_KEY=
EMAIL_USER=
EMAIL_PASS=
